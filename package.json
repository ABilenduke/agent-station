{
  "name": "agent-station",
  "version": "1.0.0",
  "private": true,
  "description": "One place for the skills, agents, hooks, MCP servers and CLIs used with Claude Code and Codex, published as a plugin marketplace.",
  "author": "Andrew Bilenduke (https://github.com/abilenduke)",
  "license": "MIT",
  "homepage": "https://github.com/abilenduke/agent-station#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abilenduke/agent-station.git"
  },
  "bugs": {
    "url": "https://github.com/abilenduke/agent-station/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "plugin-marketplace",
    "mcp"
  ],
  "bin": {
    "station": "station/station.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test station/test/*.test.mjs && npm --prefix plugins/devflow test",
    "validate": "node station/station.mjs validate",
    "check": "npm run lint && npm run format && npm test && npm run validate && npm --prefix plugins/devflow run check:dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5"
  }
}
