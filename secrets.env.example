# agent-station secrets. `station install` copies this file to ~/.config/agent-station/secrets.env
# (mode 600); fill in the values there and never commit that file.
#
# MCP servers in agent-station plugins read it themselves. To export the values to your shell too,
# add this line to ~/.bashrc:
#   set -a; . ~/.config/agent-station/secrets.env; set +a

# research plugin: obsidian-vault MCP server (Obsidian "Local REST API" community plugin)
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124

# jev CLI (TypeSafe)
TYPESAFE_API_KEY=

# Codex's GitHub MCP server reads its bearer token from this variable
CODEX_GITHUB_PERSONAL_ACCESS_TOKEN=

OPENAI_API_KEY=
